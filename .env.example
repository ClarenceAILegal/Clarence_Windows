# Clarence desktop / local env
# Copy to .env and fill in values:
#   cp .env.example .env

# Site password (case-sensitive)
MOTION_BOT_PASSWORD=B0ts4Justice

# Session cookie secret (auto-generated for desktop if unset)
# MOTION_BOT_SECRET_KEY=

# Do NOT put XAI_API_KEY here for multi-user installs.
# Each person saves their own key in the Clarence menu (stored per-Mac only).
# Optional model overrides (rarely needed):
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1
# CLARENCE_GROK_DEFAULT=0

# Desktop window debug (devtools)
# CLARENCE_DEBUG=1
# CLARENCE_PORT=8765
